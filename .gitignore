# Terraform
**/.terraform/
*.tfplan
*.tfstate
*.tfstate.*
crash.log
terraform.tfvars
*.auto.tfvars

# govc credentials — real values only ever go in the gitignored copy
tools/govc.env

# The govc binary and its bundled docs — a build artifact, not source;
# reproduce.sh downloads and hash-verifies it fresh instead of committing it
tools/govc.exe
tools/CHANGELOG.md
tools/LICENSE.txt
tools/README.md

# Scratch space for downloaded/edited .vmx files while working, not artifacts
tmp/

# Keys / secrets — public keys only are ever referenced by path
*.pem
*_rsa
*_ed25519
id_*
!*.pub

# Python
__pycache__/
*.pyc

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
